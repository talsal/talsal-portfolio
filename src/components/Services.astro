---
import { services } from '../data/services';
---

<section id="services" class="px-6 py-20">
  <div class="fade-in-up mx-auto max-w-6xl">
    <h2 class="mb-2 font-mono text-sm font-medium uppercase tracking-widest text-accent">
      02 — How I Can Help
    </h2>
    <p class="mb-10 max-w-2xl text-ink-muted">
      Available for full-time engineering roles and consulting engagements.
    </p>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <div class="rounded-xl border border-border bg-surface p-6 transition-colors hover:border-accent">
            <h3 class="mb-2 text-base font-semibold text-ink">{service.title}</h3>
            <p class="text-sm leading-relaxed text-ink-muted">{service.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
