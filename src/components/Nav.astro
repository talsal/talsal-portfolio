---
import { site } from '../data/site';

const links = [
  { href: '#about', label: 'About' },
  { href: '#services', label: 'Services' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#connect', label: 'Connect' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="#top" class="font-mono text-sm font-medium text-ink hover:text-accent">
      TS<span class="text-accent">.</span>
    </a>
    <ul class="hidden gap-6 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-ink-muted transition-colors hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={site.resumeUrl}
      download
      class="rounded-full border border-border px-4 py-1.5 text-sm text-ink transition-colors hover:border-accent hover:text-accent"
    >
      Resume
    </a>
  </nav>
</header>
