---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import headshot from '../assets/images/headshot.jpg';
---

<section id="top" class="relative overflow-hidden px-6 pb-24 pt-20 md:pt-28">
  <div
    class="pointer-events-none absolute -right-40 -top-40 h-96 w-96 rounded-full bg-accent opacity-10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto flex max-w-6xl flex-col items-center gap-10 text-center">
    <Image
      src={headshot}
      alt="Tal Salman"
      width={224}
      height={224}
      class="h-28 w-28 rounded-full border-2 border-accent object-cover shadow-[0_0_40px_-8px] shadow-accent"
    />

    <div class="max-w-3xl space-y-5">
      <h1 class="text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        {site.name}
      </h1>
      <p class="text-lg font-medium text-accent sm:text-xl">{site.role}</p>
      <p class="text-balance text-base leading-relaxed text-ink-muted sm:text-lg">
        {site.tagline}
      </p>
      <p class="text-sm font-medium text-ink-muted">
        Open to full-time roles &amp; consulting engagements
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="#experience"
        class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-bg transition-transform hover:scale-105"
      >
        View my work
      </a>
      <a
        href={site.links.email}
        class="rounded-full border border-border px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Let's talk
      </a>
      <a
        href={site.resumeUrl}
        download
        class="rounded-full border border-border px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Download Resume
      </a>
    </div>

    <SocialLinks />
  </div>
</section>
