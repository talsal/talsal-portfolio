---
import { skillGroups } from '../data/skills';
---

<section id="skills" class="px-6 py-20">
  <div class="fade-in-up mx-auto max-w-4xl">
    <h2 class="mb-10 font-mono text-sm font-medium uppercase tracking-widest text-accent">
      04 — Technical Toolbox
    </h2>
    <div class="grid gap-8 sm:grid-cols-2">
      {
        skillGroups.map((group) => (
          <div>
            <h3 class="mb-3 text-sm font-semibold text-ink">{group.title}</h3>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="rounded-md border border-border bg-surface px-2.5 py-1 font-mono text-xs text-ink-muted transition-colors hover:border-accent hover:text-accent">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
