---
import { site } from '../data/site';

const year = new Date().getFullYear();
const accessibilityUrl = `${import.meta.env.BASE_URL}accessibility/`;
---

<footer class="border-t border-border px-6 py-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 text-sm text-ink-muted sm:flex-row">
    <p>&copy; {year} {site.name}. Built with Astro &amp; Tailwind CSS.</p>
    <div class="flex items-center gap-4">
      <a href={accessibilityUrl} class="hover:text-accent">Accessibility Statement</a>
      <a href="#top" class="hover:text-accent">Back to top ↑</a>
    </div>
  </div>
</footer>
