---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---

<section id="connect" class="px-6 py-24">
  <div class="fade-in-up mx-auto max-w-2xl text-center">
    <h2 class="mb-4 font-mono text-sm font-medium uppercase tracking-widest text-accent">
      07 — Connect
    </h2>
    <h3 class="mb-4 text-3xl font-bold text-ink">Let's build something together</h3>
    <p class="mb-2 text-ink-muted">
      Open to full-time engineering roles and consulting engagements.
    </p>
    <p class="mb-8 text-ink-muted">{site.location}</p>

    <div class="mb-8 flex flex-col items-center gap-3">
      <a href={site.links.email} class="text-lg font-medium text-accent hover:underline">
        {site.email}
      </a>
    </div>

    <div class="flex justify-center">
      <SocialLinks />
    </div>
  </div>
</section>
